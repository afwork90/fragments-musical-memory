{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "lib": ["ES2022"],
    "rootDir": "..",
    "outDir": "../electron-dist",
    "noEmit": false
  },
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts",
    "../lib/domain/**/*.ts"
  ]
}
